# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (must point to a replica set; all Atlas
# clusters, including the free M0 tier, are replica sets).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/luxe-fund?retryWrites=true&w=majority"

# Secret used to sign session tokens. Generate with: npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the deployment (used for invite links and Auth.js).
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_NAME="Luxe Fund"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional: online payment provider (leave empty to use manual contributions)
# Supported value: razorpay
# ---------------------------------------------------------------------------
OPTIONAL_PAYMENT_PROVIDER=""
PAYMENT_PROVIDER_CLIENT_ID=""
PAYMENT_PROVIDER_CLIENT_SECRET=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Optional: Account Aggregator (consent-based bank data). Leave empty unless
# you have an approved FIU integration with an AA provider.
# ---------------------------------------------------------------------------
OPTIONAL_AA_PROVIDER=""
AA_CLIENT_ID=""
AA_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Optional: "Pay to Fund" UPI convenience (shows QR + deep link only;
# contributions are still confirmed manually).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FUND_UPI_ID=""
NEXT_PUBLIC_FUND_UPI_NAME=""
